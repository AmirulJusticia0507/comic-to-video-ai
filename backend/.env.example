DATABASE_URL=postgresql://user:password@ep-cool-site-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=change-me-with-a-strong-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=password123

# Storage: Cloudflare R2 / AWS S3 (production)
# STORAGE_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY=your_access_key
# STORAGE_SECRET_KEY=your_secret_key
# STORAGE_BUCKET_NAME=comic-videos
# STORAGE_REGION=auto
# STORAGE_FORCE_PATH_STYLE=false
#
# Storage: MinIO lokal (development) - jalankan `docker compose up -d` di root repo
STORAGE_ENDPOINT_URL=http://localhost:9100
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_NAME=comic-videos
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true

AI_PROVIDER_API_KEY=your_ai_provider_api_key

AI_PROVIDER_BASE_URL=https://griphubrouter.web.id/v1
AI_PROVIDER_MODEL=gemini-3.8-flash
AI_IMAGE_MODEL=gpt-image

VIDEO_PROVIDER=higgsfield
VIDEO_API_BASE_URL=https://api.higgsfield.ai
VIDEO_API_KEY_ID=
VIDEO_API_KEY_SECRET=your_higgsfield_key_secret
VIDEO_MODEL=alibaba/wan-3.0-prime/image-to-video
VIDEO_DURATION_SECONDS=5
VIDEO_RESOLUTION=720p
VIDEO_ASPECT_RATIO=adaptive
VIDEO_GENERATE_AUDIO=false
VIDEO_POLL_INTERVAL_SECONDS=5
VIDEO_TIMEOUT_SECONDS=900

# Archive import (POST /api/v1/panels/import-archive): ZIP native, RAR via
# unrar binary. Windows: WinRAR terdeteksi otomatis di
# C:\Program Files\WinRAR\UnRAR.exe. Production (Linux): install unrar,
# mis. apt-get install unrar. Override manual bila perlu:
# UNRAR_TOOL=/usr/bin/unrar
